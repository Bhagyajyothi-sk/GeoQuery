# GeoQueryAI — environment configuration
# Copy to `.env` in the project root and edit as needed:
#     cp .env.example .env
#
# Every value here has a working default, so the server starts with no .env
# at all. Defaults run the project fully in mock mode: no API keys, no model
# weights and no network access required.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=GeoQueryAI
APP_VERSION=0.1.0
DEBUG=false

# CORS — JSON array or a plain comma-separated list; both are accepted.
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ORIGINS=*

# ── Mock mode flags ───────────────────────────────────────────────────────────
# true  → deterministic stub responses, no network, no models
# false → real service (needs the corresponding key / weights / connectivity)
MOCK_AI=true       # Gemini query parser + grounded explanation
MOCK_SEARCH=true   # RemoteCLIP + FAISS semantic retrieval
MOCK_GEO=true      # Nominatim geocoding + Planetary Computer STAC/COG analysis

# ── Gemini (needed only when MOCK_AI=false) ──────────────────────────────────
GEMINI_API_KEY=

# ── RemoteCLIP + FAISS (needed only when MOCK_SEARCH=false) ──────────────────
# Paths are resolved relative to the project root.
REMOTECLIP_MODEL_PATH=models/RemoteCLIP-ViT-B-32.pt
FAISS_INDEX_PATH=indexes/satellite.index
TILE_METADATA_PATH=indexes/tile_metadata.json

# Average the query across several prompt phrasings. Better zero-shot recall,
# roughly 4x the encoding cost.
PROMPT_ENSEMBLE=false

# ── Geocoding (needed only when MOCK_GEO=false) ──────────────────────────────
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=GeoQueryAI-GeocodingService/1.0

# ── STAC / Planetary Computer (needed only when MOCK_GEO=false) ──────────────
STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
STAC_COLLECTION=sentinel-2-l2a
STAC_MAX_CLOUD_COVER=20.0

# ── Semantic search ───────────────────────────────────────────────────────────
DEFAULT_TOP_K=5
